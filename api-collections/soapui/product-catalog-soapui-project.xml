  <con:testSuite name="Product Catalog Regression">
    <con:settings/>
    <con:runType>SEQUENTIAL</con:runType>
    <con:testCase failOnError="true" failTestCaseOnErrors="true" keepSession="false" maxResults="0" name="CRUD lifecycle" searchProperties="true">
      <con:description>Create -&gt; read -&gt; update -&gt; duplicate SKU -&gt; delete -&gt; read deleted. Uses a unique SKU per run.</con:description>
      <con:settings/>
      <con:testStep type="request" name="Create product">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:RequestStep">
          <con:interface>ProductCatalogPortBinding</con:interface>
          <con:operation>createProduct</con:operation>
          <con:request name="Create product">
            <con:settings/>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>${#Project#endpoint}</con:endpoint>
            <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
   <soapenv:Header/>
   <soapenv:Body>
      <cat:createProduct>
         <product>
            <sku>${#TestCase#sku}</sku>
            <name>SoapUI Test Lamp</name>
            <description>Created by the SoapUI test suite</description>
            <category>SoapUI</category>
            <price>1299.50</price>
            <stock>10</stock>
         </product>
      </cat:createProduct>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
            <con:assertion type="SOAP Response" name="Valid SOAP Response"/>
            <con:assertion type="Not SOAP Fault Assertion" name="Not a SOAP Fault"/>
            <con:assertion type="Response SLA Assertion" name="Responds within 3000 ms">
              <con:configuration>
                <SLA>3000</SLA>
              </con:configuration>
            </con:assertion>
            <con:assertion type="XPath Match" name="SKU is stored">
              <con:configuration>
                <path>//product/sku/text()</path>
                <content>${#TestCase#sku}</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:assertion type="XPath Match" name="Price has 2 decimals">
              <con:configuration>
                <path>//product/price/text()</path>
                <content>1299.50</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:assertion type="GroovyScriptAssertion" name="Id and timestamps assigned">
              <con:configuration>
                <scriptText>def xml = new XmlSlurper().parseText(messageExchange.responseContent)
def p = xml.'**'.find { it.name() == 'product' }
assert (p.id.text() as long) &gt; 0
assert p.createdAt.text() ==~ /\d{4}-\d{2}-\d{2}T.*/</scriptText>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
            <con:jmsPropertyConfig/>
            <con:wsaConfig mustUnderstand="NONE" version="200508"/>
            <con:wsrmConfig version="1.2"/>
          </con:request>
        </con:config>
      </con:testStep>
      <con:testStep type="transfer" name="Remember product id">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:PropertyTransfersStep">
          <con:transfers setNullOnMissingSource="false" transferTextContent="true" failOnError="true" ignoreEmpty="false" transferToAll="false" entitize="false" transferChildNodes="false">
            <con:name>productId</con:name>
            <con:sourceType>Response</con:sourceType>
            <con:sourceStep>Create product</con:sourceStep>
            <con:sourcePath>//product/id</con:sourcePath>
            <con:targetType>productId</con:targetType>
            <con:targetStep>#TestCase#</con:targetStep>
          </con:transfers>
        </con:config>
      </con:testStep>
      <con:testStep type="request" name="Get product">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:RequestStep">
          <con:interface>ProductCatalogPortBinding</con:interface>
          <con:operation>getProduct</con:operation>
          <con:request name="Get product">
            <con:settings/>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>${#Project#endpoint}</con:endpoint>
            <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
   <soapenv:Header/>
   <soapenv:Body>
      <cat:getProduct>
         <id>${#TestCase#productId}</id>
      </cat:getProduct>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
            <con:assertion type="SOAP Response" name="Valid SOAP Response"/>
            <con:assertion type="Not SOAP Fault Assertion" name="Not a SOAP Fault"/>
            <con:assertion type="XPath Match" name="Same product returned">
              <con:configuration>
                <path>//product/name/text()</path>
                <content>SoapUI Test Lamp</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
            <con:jmsPropertyConfig/>
            <con:wsaConfig mustUnderstand="NONE" version="200508"/>
            <con:wsrmConfig version="1.2"/>
          </con:request>
        </con:config>
      </con:testStep>
      <con:testStep type="request" name="Update product">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:RequestStep">
          <con:interface>ProductCatalogPortBinding</con:interface>
          <con:operation>updateProduct</con:operation>
          <con:request name="Update product">
            <con:settings/>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>${#Project#endpoint}</con:endpoint>
            <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
   <soapenv:Header/>
   <soapenv:Body>
      <cat:updateProduct>
         <id>${#TestCase#productId}</id>
         <product>
            <sku>${#TestCase#sku}</sku>
            <name>SoapUI Test Lamp v2</name>
            <category>SoapUI</category>
            <price>999</price>
            <stock>4</stock>
         </product>
      </cat:updateProduct>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
            <con:assertion type="SOAP Response" name="Valid SOAP Response"/>
            <con:assertion type="Not SOAP Fault Assertion" name="Not a SOAP Fault"/>
            <con:assertion type="XPath Match" name="Name replaced">
              <con:configuration>
                <path>//product/name/text()</path>
                <content>SoapUI Test Lamp v2</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:assertion type="XPath Match" name="Price normalized to 2 decimals">
              <con:configuration>
                <path>//product/price/text()</path>
                <content>999.00</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:assertion type="XPath Match" name="Description cleared (full replace)">
              <con:configuration>
                <path>count(//product/description)</path>
                <content>0</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
            <con:jmsPropertyConfig/>
            <con:wsaConfig mustUnderstand="NONE" version="200508"/>
            <con:wsrmConfig version="1.2"/>
          </con:request>
        </con:config>
      </con:testStep>
      <con:testStep type="request" name="Create duplicate SKU">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:RequestStep">
          <con:interface>ProductCatalogPortBinding</con:interface>
          <con:operation>createProduct</con:operation>
          <con:request name="Create duplicate SKU">
            <con:settings/>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>${#Project#endpoint}</con:endpoint>
            <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
   <soapenv:Header/>
   <soapenv:Body>
      <cat:createProduct>
         <product>
            <sku>${#TestCase#sku}</sku>
            <name>Duplicate</name>
            <price>1.00</price>
            <stock>1</stock>
         </product>
      </cat:createProduct>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
            <con:assertion type="SOAP Fault Assertion" name="Is a SOAP Fault"/>
            <con:assertion type="XPath Match" name="Fault code is DUPLICATE_SKU">
              <con:configuration>
                <path>//*:CatalogFault/code/text()</path>
                <content>DUPLICATE_SKU</content>
                <allowWildcards>false</allowWildcards>
                <ignoreNamspaceDifferences>false</ignoreNamspaceDifferences>
                <ignoreComments>false</ignoreComments>
              </con:configuration>
            </con:assertion>
            <con:assertion type="GroovyScriptAssertion" name="Fault has a traceId and no stack trace">
              <con:configuration>
                <scriptText>def body = messageExchange.responseContent
def xml = new XmlSlurper().parseText(body)
def traceId = xml.'**'.find { it.name() == 'traceId' }?.text()
assert traceId
assert !body.contains('at com.infy')</scriptText>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
            <con:jmsPropertyConfig/>
            <con:wsaConfig mustUnderstand="NONE" version="200508"/>
            <con:wsrmConfig version="1.2"/>
          </con:request>
        </con:config>
      </con:testStep>
      <con:testStep type="request" name="Delete product">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:RequestStep">
          <con:interface>ProductCatalogPortBinding</con:interface>
          <con:operation>deleteProduct</con:operation>
          <con:request name="Delete product">
            <con:settings/>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>${#Project#endpoint}</con:endpoint>
            <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
   <soapenv:Header/>
   <soapenv:Body>
      <cat:deleteProduct>
         <id>${#TestCase#productId}</id>
      </cat:deleteProduct>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
            <con:assertion type="SOAP Response" name="Valid SOAP Response"/>
            <con:assertion type="Not SOAP Fault Assertion" name="Not a SOAP Fault"/>
            <con:assertion type="Simple Contains" name="Empty delete response">
              <con:configuration>
                <token>deleteProductResponse</token>
                <ignoreCase>false</ignoreCase>
                <useRegEx>false</useRegEx>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
            <con:jmsPropertyConfig/>
            <con:wsaConfig mustUnderstand="NONE" version="200508"/>
            <con:wsrmConfig version="1.2"/>
          </con:request>
        </con:config>
      </con:testStep>
      <con:testStep type="request" name="Get deleted product">
        <con:settings/>
        <con:config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="con:RequestStep">
          <con:interface>ProductCatalogPortBinding</con:interface>
          <con:operation>getProduct</con:operation>
          <con:request name="Get deleted product">
            <con:settings/>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>${#Project#endpoint}</con:endpoint>

meta {
  name: Page past the end
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/ws/v1/products
  body: xml
  auth: none
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
    <soapenv:Header/>
    <soapenv:Body>
      <cat:listProducts>
        <page>999</page>
        <size>10</size>
      </cat:listProducts>
    </soapenv:Body>
  </soapenv:Envelope>
}

tests {
  const tag = (name) => ((res.getBody() || '').match(new RegExp('<' + name + '>([^<]*)</' + name + '>')) || [])[1];
  const tags = (name) => [...(res.getBody() || '').matchAll(new RegExp('<' + name + '>([^<]*)</' + name + '>', 'g'))].map(m => m[1]);
  const n = (name) => Number(tag(name));
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("no items", () => expect(tags("sku")).to.have.length(0));
  test("totals still reported", () => expect(n("totalElements")).to.be.at.least(0));
  test("no next page", () => expect(tag("hasNext")).to.equal("false"));
}

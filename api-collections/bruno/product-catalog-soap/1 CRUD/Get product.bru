meta {
  name: Get product
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ws/v1/products
  body: xml
  auth: none
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
    <soapenv:Header/>
    <soapenv:Body>
      <cat:getProduct>
        <id>{{productId}}</id>
      </cat:getProduct>
    </soapenv:Body>
  </soapenv:Envelope>
}

tests {
  const tag = (name) => ((res.getBody() || '').match(new RegExp('<' + name + '>([^<]*)</' + name + '>')) || [])[1];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("same product", () => expect(tag("sku")).to.equal(bru.getVar("sku")));
  test("name", () => expect(tag("name")).to.equal("Bruno Test Lamp"));
}

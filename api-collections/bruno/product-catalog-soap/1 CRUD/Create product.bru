meta {
  name: Create product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ws/v1/products
  body: xml
  auth: none
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cat="http://catalog.infy.com/v1">
    <soapenv:Header/>
    <soapenv:Body>
      <cat:createProduct>
        <product>
          <sku>{{sku}}</sku>
          <name>Bruno Test Lamp</name>
          <description>Created by the Bruno collection</description>
          <category>Bruno</category>
          <price>1299.50</price>
          <stock>10</stock>
        </product>
      </cat:createProduct>
    </soapenv:Body>
  </soapenv:Envelope>
}

script:pre-request {
  bru.setVar("sku", "BRUNO-" + Date.now());
}

script:post-response {
  const tag = (name) => ((res.getBody() || '').match(new RegExp('<' + name + '>([^<]*)</' + name + '>')) || [])[1];
  const id = tag("id");
  if (id) bru.setVar("productId", id);
}

tests {
  const tag = (name) => ((res.getBody() || '').match(new RegExp('<' + name + '>([^<]*)</' + name + '>')) || [])[1];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("id assigned", () => expect(Number(tag("id"))).to.be.above(0));
  test("SKU stored upper-case", () => expect(tag("sku")).to.equal(bru.getVar("sku")));
  test("price has 2 decimals", () => expect(tag("price")).to.equal("1299.50"));
  test("timestamps set", () => expect(tag("createdAt")).to.match(/^\d{4}-\d{2}-\d{2}T/));
}
